<svg class="hero-sprig" viewBox="0 0 160 420" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path pathLength="1" style="--n: 0" d="M70 400 Q20 240 130 90"/>
<path pathLength="1" style="--n: 1" d="M56 336 Q45 309 16 306 Q27 333 56 336"/>
<path pathLength="1" style="--n: 2" d="M56 336 Q82 336 94 314 Q68 314 56 336"/>
<path pathLength="1" style="--n: 3" d="M56 274 Q42 249 14 250 Q28 275 56 274"/>
<path pathLength="1" style="--n: 4" d="M56 274 Q84 272 96 246 Q68 248 56 274"/>
<path pathLength="1" style="--n: 5" d="M68 212 Q60 184 32 178 Q40 206 68 212"/>
<path pathLength="1" style="--n: 6" d="M68 212 Q94 216 110 194 Q84 190 68 212"/>
<path pathLength="1" style="--n: 7" d="M92 150 Q88 122 62 112 Q66 140 92 150"/>
<path pathLength="1" style="--n: 8" d="M92 150 Q116 158 134 140 Q110 132 92 150"/>
