</svg>
{%- endmacro %}

{#- Faint stars in the home page's night sky. Each: left %, top %, size px, twinkle seconds, delay seconds. -#}
{% macro stars() -%}
<div class="hero-stars" aria-hidden="true">
{%- for s in [[3,12,2,5.5,0],[8,88,1.5,7,2.1],[22,6,1.5,6.2,0.8],[38,4,2,8,3.2],[49,92,1.5,6.5,1.1],[55,10,2,7.4,0.4],[62,78,1.5,5.8,2.6],[70,18,2.5,9,1.7],[76,90,2,6.6,0.2],[84,8,1.5,7.8,3.6],[90,40,2,5.4,1.2],[94,70,1.5,8.4,2.9],[97,16,2,6.9,0.6],[46,52,1.5,9.5,4.1]] %}
<span class="hero-star" style="left: {{ s[0] }}%; top: {{ s[1] }}%; --size: {{ s[2] }}px; --dur: {{ s[3] }}s; --delay: {{ s[4] }}s"></span>
{%- endfor %}
</div>
{%- endmacro %}
