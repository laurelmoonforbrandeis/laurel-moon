<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url | stripSlash }}{{ page.url }}">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url | stripSlash }}{{ page.url }}">
{%- if ogImage %}
<meta property="og:image" content="{{ site.url | stripSlash }}{{ ogImage }}">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Hanken+Grotesk:wght@400;500;600&family=Spectral:ital,wght@0,400;0,500;1,400&display=swap">
<link rel="stylesheet" href="/assets/css/style.css">
<script>
  // Runs before the page appears: turns on enhancements, and skips the home page's
  // opening animation if this visitor has already seen it during this visit.
  (function () {
    var root = document.documentElement;
    root.classList.add("js");
    try { if (sessionStorage.getItem("lm-hero-seen")) root.classList.add("hero-seen"); } catch (e) {}
  })();
</script>
<script src="/assets/js/main.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>
